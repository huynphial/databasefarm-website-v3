# =============================================================================
# DatabaseFarm - Enterprise Database Monitoring Platform
# Powered by Google AI | Author: Nguyen Xuan Luu
# Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & Server Configuration
# -----------------------------------------------------------------------------
# Node runtime environment (development | production)
NODE_ENV="development"

# Application listening port (Default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Storage Engine & Database Configuration
# -----------------------------------------------------------------------------
# Storage provider selection ("prisma" for MySQL relational DB | "memory" for transient state)
STORAGE_TYPE="prisma"

# Primary MySQL Connection String for Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://dbmon_user:secret_storage_password@127.0.0.1:3306/db_monitoring_system"

# -----------------------------------------------------------------------------
# Authentication & Session Security Configuration
# -----------------------------------------------------------------------------
# User inactivity session timeout in minutes (Default: 30 minutes)
SESSION_TIMEOUT_MINUTES=30

# Base URL for the Web Application
NEXTAUTH_URL="http://localhost:3000"

# JWT Secret Key for NextAuth / Session Encryption (e.g., openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-jwt-nextauth-key-change-in-production"

# Master Encryption Key for Monitored Database Passwords (AES-256)
AES_ENCRYPTION_KEY="your-master-32-byte-aes-encryption-key-for-database-credentials"

# Default Admin User Seed Credentials
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace_with_a_secure_admin_password_123!"

# Default Viewer (Read-Only) User Seed Credentials
SEED_VIEWER_USERNAME="viewer"
SEED_VIEWER_PASSWORD="replace_with_a_secure_viewer_password_123!"

# -----------------------------------------------------------------------------
# Collector API Health Check & Monitoring Module
# -----------------------------------------------------------------------------
# Default Target Endpoint URL for Collector API Health Check
COLLECTOR_HEALTH_CHECK_URL="http://localhost:3000/api/collector/mock-health"

# -----------------------------------------------------------------------------
# Notification Channels Configuration
# -----------------------------------------------------------------------------
# Telegram Alerting API Endpoint & Credentials
TELEGRAM_API_URL="https://api.telegram.org"
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-1001234567890"

# SMTP Email Alerting Configuration
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="alerts@dbfarm.internal"

# -----------------------------------------------------------------------------
# Localization & Display Settings
# -----------------------------------------------------------------------------
# Default Timezone for metrics and alert logs (Default: Asia/Ho_Chi_Minh)
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
